# Repository-wide ignores for generated files and OS/editor cruft.
#
# Web-project rules live in saturnv-3d/.gitignore. Git applies nested
# .gitignore files, so the two compose and neither needs to repeat the other.

# Jupyter auto-save checkpoints. These are generated by the notebook editor and
# are not part of the coursework. Note: 22 of these files are ALREADY tracked
# under PYTHON/.ipynb_checkpoints/ — this rule only affects new ones. To also
# drop the existing ones from tracking, run:
#   git rm -r --cached PYTHON/.ipynb_checkpoints
# (that is left to you deliberately: it rewrites what the coursework repo holds.)

# Python caches and compiled output
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.mypy_cache/
.pytest_cache/
.ruff_cache/

# Virtual environments
.venv/
venv/

# Editor and OS cruft
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.vs/
*.swp
*.swo
*~
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
Desktop.ini

# Local env files and keys — never commit these
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx

# Logs
*.log
npm-debug.log*
yarn-error.log*

# Local agent tooling (skills, prompts, MCP config). Machine-specific and
# large — the data catalogs alone are tens of MB. Not coursework.
.opencode/